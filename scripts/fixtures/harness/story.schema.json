{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["story_id", "customer", "party", "destination", "dates", "turns", "steps", "media"],
  "properties": {
    "story_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "reply_backend": { "enum": ["openrouter", "vk_bot_mcp"] },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email_alias"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email_alias": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collaborators", "kids", "viewers", "editors"],
      "properties": {
        "collaborators": { "type": "array", "items": { "type": "object" } },
        "kids": { "type": "array", "items": { "type": "object" } },
        "viewers": { "type": "array", "items": { "type": "object" } },
        "editors": { "type": "array", "items": { "type": "object" } }
      }
    },
    "destination": { "type": "string", "minLength": 1 },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "modality", "text"],
        "properties": {
          "speaker": { "type": "string", "minLength": 1 },
          "modality": { "enum": ["text", "voice"] },
          "text": { "type": "string", "minLength": 1 },
          "voice_fixture": { "type": "string", "minLength": 1 },
          "expect": { "type": "array", "items": { "type": "string" } }
        },
        "if": { "type": "object", "required": ["modality"], "properties": { "modality": { "const": "voice" } } },
        "then": { "type": "object", "required": ["voice_fixture"] }
      }
    },
    "steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "fixture", "attach_to"],
        "properties": {
          "kind": { "enum": ["photo", "video"] },
          "fixture": { "type": "string", "minLength": 1 },
          "attach_to": { "enum": ["day", "thing"] }
        }
      }
    }
  }
}
