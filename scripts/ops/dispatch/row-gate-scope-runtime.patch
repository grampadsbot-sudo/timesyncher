     run_lane "$FIXB"; hold_done
     [ -f "$D/$TAG-DONE.hold" ] || { echo "$(ts) ROWCHECK-GIVEUP $LANE $TAG: no DONE after row fix round; NOT published" | tee -a "$LOG"; rc=5; ROWBLOCK=1; break; }
