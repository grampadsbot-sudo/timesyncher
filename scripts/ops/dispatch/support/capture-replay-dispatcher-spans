def capture_and_compare(out, base, api_origin, target, note, reference=None, no_vision=False, structure=False, data_snapshot=None, require_data_snapshot=False, capture_fixture=None, merge_base_sha=None, pr_files=None, pr_number=None):
    env = dict(os.environ, TSV_CAPTURE_BASE=base)
    if api_origin: env["TSV_CAPTURE_API_ORIGIN"] = api_origin
    if data_snapshot: env["TSV_DATA_SNAPSHOT"] = data_snapshot
    if capture_fixture: env["TSV_CAPTURE_FIXTURE"] = capture_fixture   # capture.mjs pins its sha256 + path in capture-manifest.json
    if os.path.isdir(out): subprocess.run(["rm", "-rf", out])
    rc, o, e = run([CAPTURE_SCRIPT, out], env=env, timeout=900)
    if rc:
        LAST_CAPTURE.update({"tail": ((e or "") + "\n" + (o or "")).strip()[-3000:], "out": out})
        return None, "capture failed rc=%s %s" % (rc, (e or o).strip()[-200:])
    data_res, ratchet_meta = data_precheck(out, data_snapshot, require=require_data_snapshot,
                                           merge_base_sha=merge_base_sha, pr_files=pr_files, pr_number=pr_number)
    if data_res and data_res.get("overall") == "DATA_FAULT": return data_res, None
    if structure:   # Gate B structure mode (Craig 2026-10-08 12:27 PM PT): the pixel-exact compare is skipped entirely
        res = {"overall": "SKIPPED", "out": out, "verdicts": {}, "structure": True, "posted": False}
        if data_res: res.update(data_res)
        return res, None
    cmd = [HOME + "/tsv-gateb/gateb_compare.sh", "--baselines", reference or BASELINES, "--candidates", out, "--note", note]
    if target and not DRY: cmd += ["--target", target]
    ui_paths = pr_file_paths(pr_files) if pr_files else None
    if ui_paths and ui_files(ui_paths): cmd += ["--force"]
    if data_snapshot and not (data_res and data_res.get("contract_ratchet")):
        cmd += ["--data-snapshot", data_snapshot]
    if no_vision: cmd += ["--no-vision"]
    rc, o, e = run(cmd, timeout=900)
    try:
        res = json.loads(o.strip().splitlines()[-1])
        if data_res: res.update(data_res)
        if "out" not in res: res["out"] = out
        return res, None
    except Exception: return None, "gateb_compare output unreadable rc=%s %s" % (rc, (e or o).strip()[-200:])
def local_capture(sha, ref, out, fixture=None):
    """Sandboxed build of `sha` + capture from 127.0.0.1. `fixture` = the capture fixture (None: the static NYC fixture).
    Returns error string or None."""
    rc, o, e = run([PR_RENDER, sha, ref], timeout=1500)
    if rc: return "build failed: %s" % (e or o).strip()[-200:]
    srv = subprocess.Popen(["python3", SERVE_DIST, PR_SRC + "/dist", str(LOCAL_PORT)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        time.sleep(1.5)
        env = dict(os.environ, TSV_CAPTURE_BASE="http://127.0.0.1:%d" % LOCAL_PORT, TSV_CAPTURE_API_ORIGIN=STAGING_ORIGIN)
        if fixture: env["TSV_CAPTURE_FIXTURE"] = fixture
        if os.path.isdir(out): subprocess.run(["rm", "-rf", out])
        rc, o, e = run([CAPTURE_SCRIPT, out], env=env, timeout=900)
        return None if rc == 0 else "capture failed: %s" % (e or o).strip()[-200:]
    finally: srv.terminate()
def staging_capture(out):
    """Screens of whatever staging serves right now (the capture script resolves a relative outdir under capture/, so pass absolute)."""
    out = os.path.abspath(out)
    if os.path.isdir(out): subprocess.run(["rm", "-rf", out])
    rc, o, e = run([CAPTURE_SCRIPT, out], env=dict(os.environ, TSV_CAPTURE_BASE=STAGING_ORIGIN), timeout=900)
    return (out, None) if rc == 0 else (None, "capture failed rc=%s %s" % (rc, (e or o).strip()[-200:]))
def route_protected(pr, labels, bad):
    """Keep protected paths held; route source/host repair to the managing dr."""
    n = pr["number"]; done = STATE.setdefault("protected_routed", {})
    if str(n) in done or PROTECTED_HOLD in labels: return
    write("POST", "/repos/%s/issues/%d/labels" % (REPO, n), {"labels": [PROTECTED_HOLD, "needs-dr-eggbot"]}, "PR #%d add protected-paths hold + managing-dr routing" % n)
    write("POST", "/repos/%s/issues/%d/comments" % (REPO, n), {"body": "Ubuntu pipeline retains the protected-path merge hold on head `%s` (%s). This routing notice does not establish a Gate B pass.\n\nNext action: managing dr owns the source split or guarded host delivery; Craig is not asked to override infrastructure or merge guards.\n\n_Ubuntu cron, %s_" % (pr["head"]["sha"][:7], ", ".join(bad[:4]), pt_now())}, "PR #%d protected-paths managing-dr notice" % n)
    if not DRY:
        done[str(n)] = {"at": pt_now(), "sha": pr["head"]["sha"], "files": bad[:10]}; save_state()
    log("PR #%d routed to managing dr: %s (protected paths: %s)" % (n, PROTECTED_HOLD, ", ".join(bad[:4])))
def _sanctioned_replay_producer_head():
    raw = (os.environ.get("TSV_SANCTIONED_REPLAY_PRODUCER_HEAD") or "").strip().lower()
    return raw if re.fullmatch(r"[0-9a-f]{40}", raw) else None
def base_reference_capture(base_sha, staging, fixture=None):
    out = "%s/gateb-cand/base-%s" % (D, base_sha[:7])
    err = local_capture(base_sha, staging, out)
    return out, err
def pregate_run_capture(sha, n, out, base, api_origin, new_look, note, reference, bo, look, structure, snap, base_sha, files, cap_fixture):
    res, err = capture_and_compare(out, base, api_origin, None if new_look else "%s#%d" % (REPO, n), note, reference, no_vision=bool(bo or look), structure=structure,
                                   data_snapshot=snap, require_data_snapshot=structure, capture_fixture=cap_fixture,
                                   merge_base_sha=base_sha, pr_files=files, pr_number=n)
    return res, err
def deploy_pre_staging_capture(last_sha):
    return staging_capture("%s/gateb-cand/predeploy-%s" % (D, (last_sha or "none")[:7]))
def postdeploy_staging_capture(tip):
    return staging_capture("%s/gateb-cand/staging-%s" % (D, tip[:7]))
def staging_gate_capture(sha, dpl):
    out = "%s/gateb-cand/staging-%s" % (D, sha[:7])
    return capture_and_compare(out, STAGING_ORIGIN, None, None, "Post-deploy Gate B on staging %s (%s), Ubuntu cron" % (dpl, sha[:7]))
