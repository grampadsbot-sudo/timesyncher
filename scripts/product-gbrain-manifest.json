    "timesyncher-vacation-telegram-collaborators",
    "timesyncher-vacation-support-router",
    "timesyncher-vacation-public-source-orchestrator"
  ],
  "allowedToolLanes": [
    "public-web-search",
    "browser-automation",
    "weather",
    "filesystem-read-product-gbrain",
    "hosted-queue-read-write",
    "trek-agent-edit-runner",
    "stripe-checkout-addon",
    "telegram-collaborator-invite"
  ],
  "blockedCapabilities": [
    "gmail",
    "google-calendar",
    "google-drive",
    "google-contacts",
    "social-posting",
    "owner-private-gbrain-browse",
    "general-openclaw-admin",
    "shell-access-for-customer"
  ],
  "capturePolicy": {
    "captureOutboundResponses": true,
    "captureRawCustomerRequests": true,
    "captureTimings": true,
    "initialReviewCohort": 20
  },
  "completionPolicy": {
    "onboardingSetup": {
      "minimumSourceLinkedCandidatesForKnownHawaiiFlow": 8,
      "mustCreateConcreteFirstPassItinerary": true,
      "mustCreateWebItineraryUrlWhenOnboardingTokenExists": true,
      "mustPersistArtifact": true,
      "mustPersistSourceLinkedResearchCandidates": true,
      "mustSendOrQueueCustomerResponse": true,
      "notes": "Hosted worker may send a concise chat response, but the durable output must include a web itinerary page populated with source-linked candidates, caveats, and next verification steps. Do not mark a client-facing setup complete if it only restates intake text or creates queued placeholder artifacts.",
      "placeholderOnlyArtifactsAreIncomplete": true,
      "telegramRequestsSendThroughBotWhenChatIdAvailable": true
    },
    "placeholderRule": "If only placeholders were created, return retry/queued status or create a follow-up itinerary-generation job; do not report completed to the customer.",
    "telegramDelivery": "For Telegram-originated onboarding_setup requests, send the initial itinerary draft back through the TimeSyncher Vacation bot when a telegramChatId is available."
  },
  "customerFacing": true,
  "defaultRuntime": "TimeStopper",
  "displayName": "TimeSyncher Vacation Product GBrain",
  "intakePolicy": {
    "vacationNamingFirst": {
      "askBeforeTripDetails": true,
      "avoidRandomLookingCustomerUrls": true,
      "publicItinerarySlugUsesVacationName": true,
      "requiredFields": [
        "vacationName",
        "unforgettableGoal"
      ],
      "tripTitleUsesVacationName": true
    },
    "supportRouter": {
      "policySkill": "timesyncher-vacation-support-router",
      "canonicalEntrypoint": "/api/vacation-telegram-turn",
      "runsAfterSessionCustomerLookup": true,
      "telegramBridgeMayAnswerAccountQuestions": false,
      "telegramBridgeMayUseDefaultTripToken": false,
      "supportOrAccountQuestionsQueueWorker": false,
      "mediaAttachRequiresResolvedTripContext": true,
      "missingMediaContextBehavior": "fail_closed_clarify",
      "currentTurnIntentRequiredBeforeTranscriptWrite": true,
      "priorTranscriptMayNotUpgradeQuestionToWrite": true,
      "structuredRouterDecisionPreferred": true,
      "modelRouterReturnsStructuredDecision": true,
      "modelRouterFailsClosedOnLowConfidence": true,
      "explicitNewVacationIgnoresExistingTripContext": true,
      "newVacationRequiresCreateNewTrip": true,
      "newVacationMayUpdateExistingTripByTitle": false,
      "newVacationForbidsInheritedTripName": true,
      "staleTokenDestinationMismatchBehavior": "fail_closed_no_write",
      "existingTripCorrectionRequiresMatchingTripContext": true,
      "durationNightsInferInclusiveDays": true,
      "relativeEndDateParsesAgainstCustomerTimezone": true,
      "existingVacationCopyWhenUrlExists": "update_existing_vacation_website",
      "newVacationAdviceQuestionsQueueWorker": false,
      "vagueNextStepQuestionsQueueWorker": false,
      "vacationExistenceQuestionsQueueWorker": false,
      "accessibleVacationStateLookupRequired": true,
      "customerCopyMustHideTelegramLinkage": true,
      "vacationExistenceNoMatchCopy": "I could not find a matching vacation site yet.",
      "telegramTurnDrainMaxJobs": 1,
      "forbiddenCustomerCopy": [
        "TREK",
        "GBrain",
        "worker",
        "research workspace",
        "public research pass",
        "capability gate",
        "sqlite",
        "Traceback",
        "/home/"
      ]
    }
  },
  "lodgingPolicy": {
    "airbnb": "Search Airbnb only when the customer explicitly asks for Airbnb, vacation rentals, houses, condos, apartments, or more space.",
    "default": "Search hotels first.",
    "normalization": "Airbnb results display as category hotel with subtype Airbnb."
  },
  "name": "timesyncher-vacation",
  "owner": "TimeStopper",
  "productBoundaries": {
    "booking": {
      "customerBooksThemselves": true,
      "forbiddenCustomerCopy": [
        "Nothing is booked yet",
        "we can book",
        "I can book",
        "booking is pending"
      ],
      "notes": "Do not imply TimeSyncher Vacation books, holds, reserves, or can complete travel purchases. Itinerary setup is planning software only.",
      "requiredCustomerCopy": "TimeSyncher Vacation helps organize and compare itinerary options. Customers verify details and make any bookings themselves.",
      "timeSyncherDoesNotBookTravel": true
    }
  },
  "promotionPolicy": {
    "direction": "one-way",
    "from": "private/dev GBrain",
    "requires": [
      "allowlist approval",
      "resolver fit",
      "no Google/private owner capabilities",
      "smoke validation"
