      "skill": "timesyncher-vacation-public-research-worker",
      "runtime": "/home/timesyncher-agent/timestopper-vacation-worker/vacation-public-research-worker.mjs",
      "mode": "public-provider-or-fixture-smoke",
      "liveProviderEnv": "PERPLEXITY_API_KEY + TIMESYNCHER_PUBLIC_RESEARCH_LIVE=1",
      "failsClosedStatus": "provider_not_configured",
      "writesSourceBackedThingsToTrek": true,
      "minimumInitialResearchMinutes": 10,
      "targetInitialResearchMinutes": 15
    },
    "existingTripEditWorker": {
      "skill": "timesyncher-travel-assistant",
      "deterministicRuntime": "/home/timesyncher-agent/timestopper-vacation-worker/trek-itinerary-edit.mjs",
      "broadRuntime": "/home/timesyncher-agent/timestopper-vacation-worker/trek-agent-edit.mjs",
      "model": "grok-4.5",
      "mode": "deterministic-fast-path-then-grok-structured-plan-deterministic-apply",
      "requiresSharedUrlOrKnownTrip": true,
      "requiresPostChangeSmoke": true,
      "allowedScope": "existing TREK trip data, shared thing fields, day assignments, share/access/member settings, and product-approved travel artifacts only",
      "failsClosedStatus": "needs_manual_review"
    }
  },
  "collaboratorEntitlementPolicy": {
