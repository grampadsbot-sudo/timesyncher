                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              "catalog_revision": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "key",
              "value",
              "catalog_revision"
            ]
          }
        },
        "access_rights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
