{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VK Trip State v1 \u2014 canonical trip and turn snapshot (final merged v1, updated for the 11/26 8:22 PM HST ruling: proactive itinerary, travelers \u2260 access grants, proposed times)",
  "description": "Map keys are stable trip-scoped IDs. Provenance, readback, transitions and relational invariants are specified in SPEC.md. Assignments carry proposed_by=system|customer. Clock times the system guesses use time.precision=proposed. saved.travelers are people on the trip and never imply collaborator, editor, or viewer access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "trip_id": {
      "$ref": "#/$defs/id"
    },
    "updated_turn": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "planning",
        "reply_ready",
        "shipped"
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "saved": {
      "$ref": "#/$defs/saved"
    },
    "disclosed": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    },
    "candidates": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/candidate"
      }
    },
    "research": {
      "$ref": "#/$defs/research"
    },
    "proposals": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/proposal"
      }
    },
    "open_asks": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/ask"
          },
          {
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "needs_info"
                ]
              }
            }
          }
        ]
      }
    },
    "answered": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/ask"
          },
          {
            "properties": {
              "status": {
                "enum": [
                  "done",
                  "declined"
                ]
              },
              "outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              }
            }
          }
        ]
      }
    },
    "said": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/said"
      }
    },
    "last_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "tool_status": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/status"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1,
      "maxItems": 3
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "full",
            "focus"
          ]
        },
        "omitted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capabilities": {
              "type": "integer",
              "minimum": 1
            },
            "saved": {
              "type": "integer",
              "minimum": 1
            },
            "disclosed": {
              "type": "integer",
              "minimum": 1
            },
            "candidates": {
              "type": "integer",
              "minimum": 1
            },
            "research": {
              "type": "integer",
              "minimum": 1
            },
            "proposals": {
              "type": "integer",
              "minimum": 1
            },
            "open_asks": {
              "type": "integer",
              "minimum": 1
            },
            "answered": {
              "type": "integer",
              "minimum": 1
            },
            "said": {
              "type": "integer",
              "minimum": 1
            },
            "last_actions": {
              "type": "integer",
              "minimum": 1
            },
            "tool_status": {
              "type": "integer",
              "minimum": 1
            },
            "next_steps": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": []
        }
      },
      "required": [
        "mode",
        "omitted"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "full"
              }
            }
          },
          "then": {
            "properties": {
              "omitted": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "properties": {
              "omitted": {
                "minProperties": 1
              }
            }
          }
        }
      ]
    },
    "updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/update"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "trip_id",
    "updated_turn",
    "revision",
    "phase",
    "capabilities",
    "saved",
    "disclosed",
    "candidates",
    "research",
    "proposals",
    "open_asks",
    "answered",
    "said",
    "last_actions",
    "tool_status",
    "next_steps",
    "scope",
    "updates"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
    },
    "origin": {
      "enum": [
        "customer_named",
        "search",
        "chat_action",
        "intake",
        "human",
        "collaborator",
        "legacy_site"
      ]
    },
    "kind": {
      "enum": [
        "hotel",
        "park",
        "activity",
        "meal",
        "restaurant",
        "bar",
        "event",
        "flight_option",
        "ground_ride",
        "other"
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "precision": {
          "enum": [
            "window",
            "approximate",
            "exact",
            "proposed"
          ]
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "enum": [
                  "approximate",
                  "exact",
                  "proposed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "type": {
          "enum": [
            "hotel",
            "park",
            "activity",
            "meal",
            "restaurant",
            "bar",
            "event",
            "flight_option",
            "ground_ride",
            "other"
          ]
        },
        "basis": {
          "enum": [
            "named",
            "placeholder",
            "verified_place",
            "plan_block",
            "comparison",
            "legacy"
          ]
        },
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "proposed_by": {
          "enum": [
            "system",
            "customer"
          ]
        }
      },
      "required": [
        "title",
        "type",
        "basis",
        "proposed_by",
        "via",
        "turn"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "item": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "hotel",
            "park",
            "activity",
            "meal",
            "restaurant",
            "bar",
            "event",
            "flight_option",
            "ground_ride",
            "other"
          ]
        },
        "role": {
          "enum": [
            "visit",
            "check_in",
            "check_out",
            "leg",
            "ride"
          ]
        },
        "time": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "proposed_by": {
          "enum": [
            "system",
            "customer"
          ]
        }
      },
      "required": [
        "id",
        "item",
        "type",
        "role",
        "time",
        "proposed_by",
        "via",
        "turn"
      ]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "assigned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "date",
        "assigned",
        "via",
        "turn"
      ]
    },
    "stay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "check_in",
        "check_out",
        "via",
        "turn"
      ]
    },
    "flight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "outbound",
            "return",
            "other"
          ]
        },
        "carrier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "enum": [
            "customer_option",
            "site_record"
          ]
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "direction",
        "carrier",
        "origin",
        "destination",
        "evidence",
        "via",
        "turn"
      ]
    },
    "ride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "ride",
            "rental",
            "transit",
            "other"
          ]
        },
        "between": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "minItems": 2,
          "maxItems": 2
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "mode",
        "between",
        "via",
        "turn"
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ]
        },
        "access": {
          "enum": [
            "view",
            "edit",
            "collaborator",
            "owner"
          ]
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "access",
        "status",
        "via",
        "turn"
      ]
    },
    "invite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ]
        },
        "access": {
          "enum": [
            "view",
            "edit",
            "collaborator"
          ]
        },
        "status": {
          "enum": [
            "held",
            "queued",
            "sent",
            "accepted",
            "expired",
            "revoked",
            "failed"
          ]
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "access",
        "status",
        "via",
        "turn"
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "$ref": "#/$defs/origin"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "title",
        "destination",
        "start",
        "end",
        "via",
        "turn"
      ]
    },
    "saved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site_revision": {
          "$ref": "#/$defs/id"
        },
        "read": {
          "enum": [
            "current",
            "stale",
            "unavailable"
          ]
        },
        "trip": {
          "$ref": "#/$defs/head"
        },
        "days": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/day"
          }
        },
        "items": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/item"
          }
        },
        "unassigned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "lodging": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/stay"
          }
        },
        "flights": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/flight"
          }
        },
        "ground": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ride"
          }
        },
        "travelers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/traveler"
          }
        },
        "collaborators": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/member"
          }
        },
        "invites": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/invite"
          }
        }
      },
      "required": [
        "site_revision",
        "read",
        "trip",
        "days",
        "items",
        "unassigned",
        "lodging",
        "flights",
        "ground",
        "travelers",
        "collaborators",
        "invites"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wiring": {
          "enum": [
            "existing",
            "adapter",
            "new"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "ready",
            "not_wired",
            "no_grant",
            "trip_locked",
            "on_hold",
            "reader_unavailable",
            "service_unavailable"
          ]
        }
      },
      "required": [
        "wiring",
        "requires",
        "enabled",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "ready"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "not": {
                  "const": "ready"
                }
              }
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "set_time": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "existing"
                    },
                    "requires": {
                      "const": [
                        "item",
                        "day",
                        "time"
                      ]
                    }
                  }
                }
              ]
            },
            "add_bar_before": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "existing"
                    },
                    "requires": {
                      "const": [
                        "anchor",
                        "day"
                      ]
                    }
                  }
                }
              ]
            },
            "undo": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "existing"
                    },
                    "requires": {
                      "const": [
                        "edit_id"
                      ]
                    }
                  }
                }
              ]
            },
            "search_places": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "adapter"
                    },
                    "requires": {
                      "const": [
                        "area",
                        "category",
                        "criteria"
                      ]
                    }
                  }
                }
              ]
            },
            "invite_collaborator": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "adapter"
                    },
                    "requires": {
                      "const": [
                        "name",
                        "email",
                        "access",
                        "send_request"
                      ]
                    }
                  }
                }
              ]
            },
            "place_on_day": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "new"
                    },
                    "requires": {
                      "const": [
                        "item",
                        "day",
                        "role"
                      ]
                    }
                  }
                }
              ]
            },
            "add_from_search": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "new"
                    },
                    "requires": {
                      "const": [
                        "candidate"
                      ]
                    }
                  }
                }
              ]
            },
            "add_named_item": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "new"
                    },
                    "requires": {
                      "const": [
                        "type",
                        "label",
                        "evidence"
                      ]
                    }
                  }
                }
              ]
            },
            "set_stay": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "new"
                    },
                    "requires": {
                      "const": [
                        "hotel",
                        "check_in",
                        "check_out"
                      ]
                    }
                  }
                }
              ]
            },
            "save_plan": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "wiring": {
                      "const": "new"
                    },
                    "requires": {
                      "const": [
                        "operations",
                        "authority"
                      ]
                    }
                  }
                }
              ]
            },
            "hold_invite": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
