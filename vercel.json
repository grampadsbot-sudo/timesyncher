{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "cursor/*": false,
      "cursor/**": false
    }
  },
  "routes": [
    {
      "src": "/api/bind-thing-media",
      "dest": "/api/[...route]?...route=bind-thing-media&mediaBind=1"
    },
    {
      "src": "/api/pdf/qr\\.svg",
      "dest": "/api/[...route]?...route=pdf&pdfQr=1"
    },
    {
      "src": "/api/pdf/shared/(.*)",
      "dest": "/api/[...route]?...route=pdf&keepsakePdf=1&pdfPath=$1"
    },
    {
      "src": "/api/shared/(.*)",
      "dest": "/api/[...route]?...route=shared&trekPath=$1"
    },
    {
      "src": "/shared/([^/]+)/journey(?:/)?",
      "dest": "/shared-app.html"
    },
    {
      "src": "/shared/([^/]+)/report/daily(?:\\.pdf)?(?:/)?",
      "dest": "/shared-app.html"
    },
    {
      "src": "/shared/([^/]+)/report/([^/?]+)",
      "dest": "/api/[...route]?...route=pdf&keepsakePdf=1&shareToken=$1&report=$2"
    },
    {
      "src": "/shared(?:/.*)?",
      "dest": "/shared-app.html"
    },
    {
      "src": "/api/vacation-web-access",
      "dest": "/api/[...route]?...route=vacation-web-access&webAccess=1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "https://travel.timesyncher.com/icons/$1"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "https://travel.timesyncher.com/manifest.webmanifest"
    },
    {
      "src": "/accept/([^/]+)",
      "dest": "/api/[...route]?...route=eula&action=accept-page&sessionId=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...route]?...route=$1"
    }
  ],
  "functions": {
    "api/[...route].mjs": {
      "maxDuration": 60,
      "includeFiles": "scripts/vacation-app-reply-rules-snapshot.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
